CREATE OR REPLACE PROCEDURE SPROC1(csv_array JSONB, csv_filename TEXT, user_email TEXT)
LANGUAGE plpgsql
AS $$
DECLARE
    csv_data JSONB;
    row_num INT := 0;
    inserted_count INT := 0;
    had_error BOOLEAN := FALSE;
BEGIN
    -- Prevent duplicate uploads
    IF EXISTS (SELECT 1 FROM manufacturing_csv_uploads WHERE file_name = csv_filename) THEN
        RAISE EXCEPTION 'File "%" has already been uploaded.', csv_filename;
    END IF;

    -- Process each row
    FOR csv_data IN SELECT * FROM jsonb_array_elements(csv_array)
    LOOP
        row_num := row_num + 1;

        -- Skip empty rows
        IF csv_data::TEXT = '{}' THEN
            RAISE WARNING 'Skipped empty row %', row_num;
            CONTINUE;
        END IF;

        BEGIN
            -- Try insert
            INSERT INTO intricon_data
            SELECT *
            FROM json_populate_record(NULL::intricon_data, csv_data::json);

            inserted_count := inserted_count + 1;
            RAISE NOTICE 'Row % inserted successfully (_id=%)', row_num, csv_data->>'_id';

        EXCEPTION
            WHEN unique_violation THEN
                had_error := TRUE;
                RAISE WARNING 'Duplicate row at row % (_id=%)', row_num, csv_data->>'_id';

            WHEN others THEN
                had_error := TRUE;
                RAISE WARNING 'Error inserting row % (id=%): % | Data: %',
                    row_num, csv_data->>'_id', SQLERRM, csv_data::TEXT;
        END;
    END LOOP;

    -- Record file upload
    INSERT INTO manufacturing_csv_uploads(file_name, uploaded_at, uploaded_by, version, rows_affected, uploaded_status)
    VALUES (csv_filename, NOW(), user_email, 1, inserted_count, NOT had_error);

    RAISE NOTICE 'Finished processing % rows. Inserted % rows. Status=%',
        row_num, inserted_count, NOT had_error;
END;
$$;



