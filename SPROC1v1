CREATE OR REPLACE PROCEDURE SPROC1(csv_array JSONB)
LANGUAGE plpgsql
AS $$
DECLARE
    csv_data JSONB;
BEGIN
    FOR csv_data IN SELECT * FROM jsonb_array_elements(csv_array)
    LOOP
        RAISE NOTICE 'Processing row: %', csv_data;

        BEGIN
            INSERT INTO intricon_data
            SELECT *
            FROM json_populate_record(NULL::intricon_data, csv_data::json);

            RAISE NOTICE 'Row inserted successfully: %', csv_data->>'_id';

        EXCEPTION WHEN OTHERS THEN
            RAISE WARNING 'Error inserting row with _id=%: %',
                csv_data->>'_id', SQLERRM;
        END;

    END LOOP;

    RAISE NOTICE 'Finished processing all rows.';
END;
$$;

