CREATE OR REPLACE PROCEDURE SPROC1(
    csv_array JSONB,
    csv_filename TEXT,
    user_email TEXT
)
LANGUAGE plpgsql
AS $$
DECLARE
    csv_data JSONB;
    row_num INT := 0;
    inserted_count INT := 0;
    had_error BOOLEAN := FALSE;
BEGIN
    -- Prevent duplicate uploads
    IF EXISTS (SELECT 1 FROM manufacturing_csv_uploads WHERE file_name = csv_filename) THEN
        RAISE NOTICE '⚠️ File "%" already uploaded. Skipping.', csv_filename;
        RETURN;
    END IF;

    -- Process each row
    FOR csv_data IN SELECT * FROM jsonb_array_elements(csv_array)
    LOOP
        row_num := row_num + 1;
        BEGIN
            INSERT INTO intricon_data
            SELECT *
            FROM json_populate_record(NULL::intricon_data, csv_data::json);

            inserted_count := inserted_count + 1;
            RAISE NOTICE '✅ Row % inserted successfully.', row_num;

        EXCEPTION WHEN OTHERS THEN
            had_error := TRUE;
            RAISE WARNING '❌ Row % failed: %', row_num, SQLERRM;
            RAISE NOTICE 'Row data: %', csv_data::TEXT;
        END;
    END LOOP;

    -- Log file upload result
    INSERT INTO manufacturing_csv_uploads(
        file_name,
        uploaded_at,
        uploaded_by,
        version,
        rows_affected,
        uploaded_status
    )
    VALUES (
        csv_filename,
        NOW(),
        user_email,
        1,
        inserted_count,
        (inserted_count > 0 AND NOT had_error)
    );

    RAISE NOTICE '📊 Finished % rows. Inserted: %, Errors: %',
        row_num, inserted_count, had_error;
END;
$$;





